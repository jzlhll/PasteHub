// Public defaults for open-source builds.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.PasteHub
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Vendor/MozJPEG/PasteHubMozJPEG.h
OTHER_LDFLAGS = $(inherited) "$(TARGET_TEMP_DIR)/MozJPEG/libPasteHubMozJPEG.a"

#include? "Config/Secrets.xcconfig"
